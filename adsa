1. Quick Sort 
import java.util.*; 
class QuickSort { 
static int partition(int a[], int l, int h) { 
int p=a[h], i=l-1; 
for(int j=l;j<h;j++) 
if(a[j]<=p) { 
i++; 
int t=a[i]; a[i]=a[j]; a[j]=t; 
} 
int t=a[i+1]; a[i+1]=a[h]; a[h]=t; 
return i+1; 
} 
static void quickSort(int a[], int l, int h) { 
if(l<h) { 
int p=partition(a,l,h); 
quickSort(a,l,p-1); 
quickSort(a,p+1,h); 
}                                                                          
} 
public static void main(String[] args) { 
int a[]={8,7,2,1,0,9,6}; 
System.out.println("Unsorted: "+Arrays.toString(a)); 
quickSort(a,0,a.length-1); 
System.out.println("Sorted: "+Arrays.toString(a)); 
} 
} 

Output: 
Unsorted: [8, 7, 2, 1, 0, 9, 6] 
Sorted: [0, 1, 2, 6, 7, 8, 9] 


2. MergeSort 
class MergeSort { 
 
    void merge(int a[], int l, int m, int r) {                    
        int temp[] = new int[r - l + 1]; 
 
        int i = l, j = m + 1, k = 0; 
 
        while (i <= m && j <= r) { 
            if (a[i] < a[j]) 
                temp[k++] = a[i++]; 
            else 
                temp[k++] = a[j++]; 
        } 
 
        while (i <= m) 
            temp[k++] = a[i++]; 
 
        while (j <= r) 
            temp[k++] = a[j++]; 
 
        for (i = 0; i < temp.length; i++) 
            a[l + i] = temp[i]; 
    } 
 
    void sort(int a[], int l, int r) { 
        if (l < r) { 
            int m = (l + r) / 2; 
 
            sort(a, l, m); 
            sort(a, m + 1, r); 
 
            merge(a, l, m, r); 
        } 
    } 
    public static void main(String args[]) { 
 
        int a[] = {6, 5, 12, 10, 9, 1}; 
 
        MergeSort obj = new MergeSort(); 
 
        obj.sort(a, 0, a.length - 1); 
 
        System.out.println("Sorted Array:"); 
 
        for (int i = 0; i < a.length; i++) 
            System.out.print(a[i] + " "); 
    } 
}    

Output Sorted Array:  1 5 6 9 10 12 
 
 
 
3. ShellSort 
 
class ShellSort { 
    public static void main(String args[]) { 
 
        int a[] = {6, 5, 12, 10, 9, 1}; 
 
        int n = a.length; 
 
        for (int gap = n / 2; gap > 0; gap = gap / 2) { 
 
            for (int i = gap; i < n; i++) { 
 
                int temp = a[i]; 
                int j; 
 
                for (j = i; j >= gap && a[j - gap] > temp; j -= gap) { 
                    a[j] = a[j - gap]; 
                } 
 
                a[j] = temp; 
            } 
        } 
 
        System.out.println("Sorted Array:"); 
 
        for (int i = 0; i < n; i++) { 
            System.out.print(a[i] + " "); 
        } 
    } 
} 
 
Output Sorted Array:  1 5 6 9 10 12 
 
 
4. Stack 
 
class Stack<T> { 
    int top = -1; 
    T stack[] = (T[]) new Object[5]; 
 
    void push(T x) { 
        if (top == 4) 
            System.out.println("Stack Overflow"); 
        else { 
            stack[++top] = x; 
            System.out.println(x + " pushed"); 
        } 
    } 
 
    void pop() { 
        if (top == -1) 
            System.out.println("Stack Underflow"); 
        else 
            System.out.println(stack[top--] + " popped"); 
    } 
 
    void display() { 
        if (top == -1) 
            System.out.println("Stack is Empty"); 
        else { 
            System.out.println("Stack Elements:"); 
            for (int i = top; i >= 0; i--) 
                System.out.println(stack[i]); 
        } 
    } 
} 
 
class Main { 
    public static void main(String args[]) { 
 
        Stack<Integer> s = new Stack<Integer>(); 
 
        s.push(10); 
        s.push(20); 
        s.push(30); 
 
        s.display(); 
 
        s.pop(); 
 
        s.display(); 
    } 
} 
Output: 
10 pushed 
20 pushed 
30 pushed 
Stack Elements: 
30 
20 
10 
30 popped 
Stack Elements: 
20 
10 


5. Queue 

class Queue<T> { 
int front = 0, rear = -1; 
T q[] = (T[]) new Object[5]; 
void enqueue(T x) { 
if (rear == 4) 
System.out.println("Queue Overflow"); 
else { 
q[++rear] = x; 
System.out.println(x + " inserted"); 
} 
} 
void dequeue() { 
if (front > rear) 
System.out.println("Queue Underflow"); 
else 
System.out.println(q[front++] + " deleted"); 
} 
void display() { 
if (front > rear) 
System.out.println("Queue is Empty"); 
else { 
System.out.println("Queue Elements:"); 
for (int i = front; i <= rear; i++) 
System.out.print(q[i] + " "); 
System.out.println(); 
} 
} 
} 
class Main { 
public static void main(String args[]) { 
Queue<Integer> q = new Queue<Integer>(); 
q.enqueue(10); 
q.enqueue(20); 
q.enqueue(30); 
q.display(); 
q.dequeue(); 
q.display(); 
} 
} 

Output: 
10 inserted 
20 inserted 
30 inserted 
Queue Elements: 
10 20 30 
10 deleted 
Queue Elements: 
20 30 


