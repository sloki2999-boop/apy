14. Write a Python class named Person with attributes name, age, 
weight (kgs), height (ft) and takes them through the constructor 
and exposes a method get_bmi_result() which returns one of 
“underweight”, “healthy”, “obese” 

class Person: 
def __init__(self, name, age, weight, height): 
self.name = name 
self.age = age 
self.weight = weight 
self.height = height 
    def get_bmi_result(self): 
        height_m = self.height * 0.3048 
        bmi = self.weight / (height_m * height_m) 
        if bmi < 18.5: 
            return "underweight" 
        elif bmi < 25: 
            return "healthy" 
        else: 
            return "obese" 
name = input("Enter name: ") 
age = int(input("Enter age: ")) 
weight = float(input("Enter weight (kgs): ")) 
height = float(input("Enter height (ft): ")) 
p = Person(name, age, weight, height) 
print("Name:", p.name) 
print("Age:", p.age) 
print("BMI Result:", p.get_bmi_result()) 
 
