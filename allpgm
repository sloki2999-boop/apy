print(b) 
print("\n----- Minimum Array -----") 
print(np.minimum(a, b)) 
print("\n----- Maximum Array -----") 
print(np.maximum(a, b)) 
print("\n----- Sum Array A -----") 
print(np.sum(a)) 
print("\n----- Sum Array B -----") 
print(np.sum(b)) 
def cumSum(s): 
sm = 0 
cum_list = [] 
for i in s: 
sm = sm + i 
cum_list.append(sm) 
return cum_list 
print("\n----- Cumulative Sum of A -----") 
print(cumSum(a)) 
print("\n----- Cumulative Sum of B -----") 
print(cumSum(b)) 

